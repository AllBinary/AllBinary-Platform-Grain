and jm_process = (this: LayerPlacer, layerPlacementInterface: LayerPlacementInterface) => {
        let mut relativePoint: GPoint = JR.cast(jm_getPoint(this, layerPlacementInterface))
        let mut layerInterfaceFactory: LayerInterfaceFactory = JR.cast(LayerInterfaceFactory.jm_getInstance())
        let mut hashtable: JObject = JR.cast(LayerPlacementInterface.jm_getInstance(layerPlacementInterface))
        let mut enumeration: Enumeration = JR.cast({
let jlate: (JObject) => JObject = JR.cast(JR.lateBound("ABHashtable.jm_keys"))
JR.cast(jlate(JR.cast(hashtable)))
})
        let mut point: GPoint = JR.nullOf()
        let mut layerHashtable: JObject = JR.jnull
        let mut x: Int32 = 0l
        let mut y: Int32 = 0l
        let mut z: Int32 = 0l
        let mut layerInterface: AllBinaryLayer = JR.nullOf()
        while (EnumerationUtil.jm_hasMoreElements(this.f_enumerationUtil, enumeration)) {
            point = JR.cast(EnumerationUtil.jm_nextElement(this.f_enumerationUtil, enumeration))
            layerHashtable = JR.cast({
let jlate: (JObject, JObject) => JObject = JR.cast(JR.lateBound("ABHashtable.jm_get"))
JR.cast(jlate(JR.cast(hashtable), JR.cast(point)))
})
            x = Int32.(+)(GPoint.jm_getX(point), GPoint.jm_getX(relativePoint))
            y = Int32.(+)(GPoint.jm_getY(point), GPoint.jm_getY(relativePoint))
            z = Int32.(+)(GPoint.jm_getZ(point), GPoint.jm_getZ(relativePoint))
            layerInterface = JR.cast(LayerInterfaceFactory.jm_getNexInstance(layerInterfaceFactory, layerHashtable, x, y, z))
            ignore(LayerInterfaceVisitor.jm_visit(this.f_layerInterfaceVisitor, layerInterface))
        }
}
    
and jm_getPoint = (this: LayerPlacer, layerPlacementInterface: LayerPlacementInterface) => {
        let mut pointFactory: PointFactory = JR.cast(PointFactory.jm_getInstance())
        let mut layerPlacementType: LayerPlacementType = JR.cast(LayerPlacementInterface.jm_getLayerType(layerPlacementInterface))
        if (JR.isSame(layerPlacementType, LayerPlacementTypeFactory.jm_getInstance().f_MAP)) {
            let mut width: Int32 = LayerPlacementInterface.jm_getWidth(layerPlacementInterface)
            let mut height: Int32 = LayerPlacementInterface.jm_getHeight(layerPlacementInterface)
            let mut x: Int32 = (Int32.(/)((Int32.(-)(GPoint.jm_getX(this.f_dimension), width)), 2l))
            let mut y: Int32 = (Int32.(/)((Int32.(-)(GPoint.jm_getY(this.f_dimension), height)), 2l))
            return PointFactory.jm_createXY(pointFactory, x, y)
        } else if (JR.isSame(layerPlacementType, LayerPlacementTypeFactory.jm_getInstance().f_UP)) {
            let mut width: Int32 = LayerPlacementInterface.jm_getWidth(layerPlacementInterface)
            let mut height: Int32 = LayerPlacementInterface.jm_getHeight(layerPlacementInterface)
            let mut x: Int32 = (Int32.(/)((Int32.(-)(GPoint.jm_getX(this.f_dimension), width)), 2l))
            let mut y: Int32 = Int32.(-)(1l, Int32.(+)(height, 1l))
            return PointFactory.jm_createXY(pointFactory, x, y)
        } else {
            fail JR.toStringOf(JR.newJObject("Exception"))
        }
    return JR.nullOf()
}

