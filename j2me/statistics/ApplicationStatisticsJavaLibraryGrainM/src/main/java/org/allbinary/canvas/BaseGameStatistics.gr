                this.f_CHAR_ARRAY[Int32.toNumber(3l)][Int32.toNumber(1l)] = this.f_PLUS_CHAR
            }
        }
        return this.f_CHAR_ARRAY
}
    
and jm_toStringArray = (this: BaseGameStatistics) => {
