                this.f_CHAR_ARRAY[Int32.toNumber(1l)][Int32.toNumber(0l)] = this.f_SPACE_CHAR
                this.f_CHAR_ARRAY[Int32.toNumber(1l)][Int32.toNumber(1l)] = this.f_primitiveLongSingleton.f_NUMBER_CHAR_ARRAY[Int32.toNumber(framesPerSec)]
            } else if (Int32.(<)(framesPerSec, 100l)) {
                let mut tens: Int32 = Int32.(/)(framesPerSec, 10l)
                let mut removeTens: Int32 = Int32.(*)(tens, 10l)
                this.f_CHAR_ARRAY[Int32.toNumber(1l)][Int32.toNumber(0l)] = this.f_primitiveLongSingleton.f_NUMBER_CHAR_ARRAY[Int32.toNumber(tens)]
                this.f_CHAR_ARRAY[Int32.toNumber(1l)][Int32.toNumber(1l)] = this.f_primitiveLongSingleton.f_NUMBER_CHAR_ARRAY[Int32.toNumber(Int32.(-)(framesPerSec, removeTens))]
            } else {
                this.f_CHAR_ARRAY[Int32.toNumber(1l)][Int32.toNumber(0l)] = this.f_PLUS_CHAR
                this.f_CHAR_ARRAY[Int32.toNumber(1l)][Int32.toNumber(1l)] = this.f_PLUS_CHAR
            }
            let mut refreshesPerSec: Int32 = Int32.fromNumber(Int64.toNumber((Int64.(/)(this.f_totalRefreshes, totalTime))))
            if (Int32.(<)(refreshesPerSec, 10l)) {
                this.f_CHAR_ARRAY[Int32.toNumber(3l)][Int32.toNumber(0l)] = this.f_X_CHAR
                this.f_CHAR_ARRAY[Int32.toNumber(3l)][Int32.toNumber(1l)] = this.f_primitiveLongSingleton.f_NUMBER_CHAR_ARRAY[Int32.toNumber(refreshesPerSec)]
            } else if (Int32.(<)(refreshesPerSec, 100l)) {
                let mut tens: Int32 = Int32.(/)(refreshesPerSec, 10l)
                let mut removeTens: Int32 = Int32.(*)(tens, 10l)
                this.f_CHAR_ARRAY[Int32.toNumber(3l)][Int32.toNumber(0l)] = this.f_primitiveLongSingleton.f_NUMBER_CHAR_ARRAY[Int32.toNumber(Int32.(/)(refreshesPerSec, 10l))]
                this.f_CHAR_ARRAY[Int32.toNumber(3l)][Int32.toNumber(1l)] = this.f_primitiveLongSingleton.f_NUMBER_CHAR_ARRAY[Int32.toNumber(Int32.(-)(refreshesPerSec, removeTens))]
            } else {
