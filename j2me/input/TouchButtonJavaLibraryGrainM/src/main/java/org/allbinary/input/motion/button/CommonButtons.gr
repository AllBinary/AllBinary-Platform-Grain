and jnew_0 = () => {
    let this = { jobject: JR.newJObject("CommonButtons"), f_STANDARD_BUTTON_SIZE: 0l, f_NORMAL_BUTTON: JR.nullOf(), f_LARGE_BUTTON: JR.nullOf(), }
    
    
    
        let mut displayInfo: DisplayInfoSingleton = JR.cast(DisplayInfoSingleton.jm_getInstance())
        let mut commonButtonSize: Int32 = 128l
        while (Int32.(>)(commonButtonSize, 64l)) {
            let mut totalColumns: Int32 = Int32.(/)(DisplayInfoSingleton.jm_getLastWidth(displayInfo), commonButtonSize)
            let mut totalRows: Int32 = Int32.(/)(DisplayInfoSingleton.jm_getLastHeight(displayInfo), commonButtonSize)
            let mut max: Int32 = totalColumns
            if (Int32.(>)(totalRows, max)) {
                max = totalRows
            }
            if (Int32.(>)(max, 9l)) {
                break
            }
            commonButtonSize = Int32.(>>)(commonButtonSize, 1l)
        }
        this.f_STANDARD_BUTTON_SIZE = commonButtonSize
        this.f_NORMAL_BUTTON = JR.cast(Rectangle.jnew_3(JR.cast(PointFactory.jm_getInstance().f_ZERO_ZERO), this.f_STANDARD_BUTTON_SIZE, this.f_STANDARD_BUTTON_SIZE))
        this.f_LARGE_BUTTON = JR.cast(Rectangle.jnew_3(JR.cast(PointFactory.jm_getInstance().f_ZERO_ZERO), Int32.(<<)(this.f_STANDARD_BUTTON_SIZE, 1l), Int32.(<<)(this.f_STANDARD_BUTTON_SIZE, 1l)))
    this
}

