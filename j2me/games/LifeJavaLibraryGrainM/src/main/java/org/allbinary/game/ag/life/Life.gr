and jm_createLife = () => {
        {
            return jnew_2(JR.i16(0l), JR.i16(0l))
        }
    return JR.nullOf()
}
    
and jnew_2 = (lives: Int32, maxlives: Int32) => {
    let this = { jobject: JR.newJObject("Life"), f_lives: 0l, f_startLives: 0l, f_maxlives: 0l, }
    
    
    
        this.f_maxlives = maxlives
        if (Int32.(>)(lives, this.f_maxlives)) {
            fail JR.toStringOf(JR.newJObject("Exception"))
        }
        this.f_lives = lives
        this.f_startLives = lives
    this
}
    
and jm_get = (this: Life) => {
        return this.f_lives
}
    
and jm_set = (this: Life, lives: Int32) => {
        this.f_lives = lives
}
    
and jm_reset = (this: Life) => {
        this.f_lives = this.f_startLives
}
    
and jm_add = (this: Life, lives: Int32) => {
        if (!jm_reachedLimit(this)) {
            if (Int32.(<=)(Int32.(+)(this.f_lives, lives), jm_getMaxlives(this))) {
                this.f_lives = JR.i16((Int32.(+)(this.f_lives, lives)))
            } else {
                this.f_lives = jm_getMaxlives(this)
            }
        }
}
    
and jm_isAlive = (this: Life) => {
        if (Int32.(<=)(this.f_lives, 0l)) {
            return false
        } else {
            return true
        }
}
    
and jm_getMaxlives = (this: Life) => {
        return this.f_maxlives
}
    
and jm_reachedLimit = (this: Life) => {
        if ((Int32.(>)(this.f_lives, this.f_maxlives) || Int32.(<)(this.f_lives, 0l))) {
            return true
        } else {
            return false
        }
}
    
and jm_deaths = (this: Life, lives: Int32) => {
        if (!jm_reachedLimit(this)) {
            if (Int32.(>=)(Int32.(-)(this.f_lives, lives), 0l)) {
                this.f_lives = JR.i16((Int32.(-)(this.f_lives, lives)))
            } else {
                this.f_lives = 0l
            }
        }
}
    
and jm_getStartLives = (this: Life) => {
        return this.f_startLives
}
    
and jm_setStartLives = (this: Life, startLives: Int32) => {
        this.f_startLives = startLives
}

