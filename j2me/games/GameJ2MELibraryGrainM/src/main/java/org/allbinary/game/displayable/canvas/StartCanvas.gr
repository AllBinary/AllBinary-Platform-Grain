and jm_demoStateChange = (this: StartCanvas) => {
        let mut newState: Int32 = Int32.(+)(this.f_state, 1l)
        if (Int32.(>)(newState, 2l)) {
            newState = 0l
        } else if ((newState == 2l)) {
            if (!HighScoresHelper.jm_isAnyHighScores(this.f_highScoresHelper)) {
                newState = 0l
            } else {
                let mut highScores: JObject = JR.cast(HighScoresHelper.jm_getNextHighScores(this.f_highScoresHelper))
                if (JR.isSame(highScores, NullHighScoresSingletonFactory.jm_getInstance())) {
                    newState = 0l
                } else {
                    ignore(HighScoresPaintable.jm_setHighScores(jm_getRealHighScoresPaintable(this), highScores))
                }
            }
        }
        ignore(jm_setState(this, newState))
        ignore(jm_updateDemoState(this))
}
    
and jm_updateDemoState = (this: StartCanvas) => {
        ignore({
let jlate: (JObject, JObject, JObject) => JObject = JR.cast(JR.lateBound("PreLogUtil.jm_put"))
JR.cast(jlate(JR.cast(JR.toStringOf(JR.cast(SmallIntegerSingletonFactory.jm_createInstance(SmallIntegerSingletonFactory.jm_getInstance(), this.f_state)))), JR.cast(this), JR.cast(this.f_SET_STATE)))
})
        ignore(StatePaintable.jm_setState(jm_getBasicGameDemoPaintable(this), this.f_state))
        if ((this.f_state == 0l)) {
            this.f_highScoresPaintable = JR.cast(NullPaintable.jm_getInstance())
            this.f_paintedSpecialAnimationInterface = JR.cast(jm_getSpecialAnimationInterface(this))
            ignore({
let jlate: (JObject) => JObject = JR.cast(JR.lateBound("IndexedAnimation.jm_reset"))
JR.cast(jlate(JR.cast(jm_getSpecialAnimationInterface(this))))
})
        } else if ((this.f_state == 1l)) {
            this.f_paintedSpecialAnimationInterface = JR.cast(SpecialAnimation.jm_getInstance())
        } else if ((this.f_state == 2l)) {
            this.f_highScoresPaintable = JR.cast(jm_getRealHighScoresPaintable(this))
        }
        let mut gameAdState: JObject = JR.cast(GameAdStateFactory.jm_getCurrentInstance(this.f_gameAdStateFactory))
        ignore({
let jlate: (JObject) => JObject = JR.cast(JR.lateBound("GameAdState.jm_processPageAdState"))
JR.cast(jlate(JR.cast(gameAdState)))
})
}
    
