and jm_getCustomCommands = (this: StartCanvas) => {
        let mut gameCommandsFactory: GameCommandsFactory = JR.cast(GameCommandsFactory.jm_getInstance())
        if (J2MEUtil.jm_isHTML()) {
            let mut commandArray: Array<JObject> = [> gameCommandsFactory.f_START_COMMAND, HighScoreCommands.jm_getInstance().f_DISPLAY, GameInputMappingCanvas.jstatic_DISPLAY(), gameCommandsFactory.f_DISPLAY_ABOUT]
            return commandArray
        } else {
            let mut commandList: BasicArrayList = JR.cast(BasicArrayListD.jnew_0())
            ignore(BasicArrayList.jm_add(commandList, JR.cast(gameCommandsFactory.f_START_COMMAND)))
            let mut inApplicationPurchaseFactory: JObject = JR.cast({
let jlate: () => JObject = JR.cast(JR.lateBound("InApplicationPurchaseFactory.jm_getInstance"))
JR.cast(jlate())
})
            if ({
let jlate: (JObject) => JObject = JR.cast(JR.lateBound("InApplicationPurchaseFactory.jm_isEnabled"))
JR.cast(jlate(JR.cast(inApplicationPurchaseFactory)))
}) {
                let mut list: BasicArrayList = JR.cast(LockableFeatureFactory.jm_getList(LockableFeatureFactory.jm_getInstance()))
                if ((Int32.(>)(BasicArrayList.jm_size(list), 0l) && !{
let jlate: (JObject, JObject) => JObject = JR.cast(JR.lateBound("InApplicationPurchaseFactory.jm_isPurchased"))
JR.cast(jlate(JR.cast(inApplicationPurchaseFactory), JR.cast(JR.cast(BasicArrayList.jm_get(list, 0l)))))
})) {
                    ignore(BasicArrayList.jm_add(commandList, JR.cast(gameCommandsFactory.f_BUY_COMMAND)))
                }
            }
            ignore(BasicArrayList.jm_add(commandList, JR.cast(HighScoreCommands.jm_getInstance().f_DISPLAY)))
            {
                let mut isOverScan: Bool = {
let jlate: (JObject) => JObject = JR.cast(JR.lateBound("GenericOperatingSystem.jm_isOverScan"))
JR.cast(jlate(JR.cast({
let jlate: (JObject) => JObject = JR.cast(JR.lateBound("OperatingSystemFactory.jm_getOperatingSystemInstance"))
JR.cast(jlate(JR.cast({
let jlate: () => JObject = JR.cast(JR.lateBound("OperatingSystemFactory.jm_getInstance"))
JR.cast(jlate())
})))
})))
}
                if (SWTUtil.jstatic_isSWT()) {
                    ignore(BasicArrayList.jm_add(commandList, JR.cast(GameInputMappingCanvas.jstatic_DISPLAY())))
                } else if (!isOverScan) {
                    ignore(BasicArrayList.jm_add(commandList, JR.cast(gameCommandsFactory.f_DISPLAY_OPTIONS)))
                    ignore(BasicArrayList.jm_add(commandList, JR.cast(gameCommandsFactory.f_DISPLAY_LOAD_FORM)))
                    ignore(BasicArrayList.jm_add(commandList, JR.cast(GameInputMappingCanvas.jstatic_DISPLAY())))
                }
            }
            ignore(BasicArrayList.jm_add(commandList, JR.cast(gameCommandsFactory.f_DISPLAY_ABOUT)))
            let mut commandArray: Array<JObject> = BasicArrayList.jm_toArray(commandList)
            return commandArray
        }
}
    
