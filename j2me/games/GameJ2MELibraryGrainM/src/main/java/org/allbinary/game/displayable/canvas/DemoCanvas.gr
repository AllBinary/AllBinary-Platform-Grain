            ignore({
let jlate: (JObject, JObject) => JObject = JR.cast(JR.lateBound("MyCanvas.jm_addCommand"))
JR.cast(jlate(JR.cast(this), JR.cast(JR.cast(commandArray[Int32.toNumber(index)]))))
