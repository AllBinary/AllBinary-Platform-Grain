and jm_demoStateChange = (this: DemoCanvas) => {
        let mut newState: Int32 = Int32.(+)(this.f_state, 1l)
        if (Int32.(>)(newState, 2l)) {
            newState = 0l
        } else if ((newState == 2l)) {
            if (!HighScoresHelperBase.jm_isAnyHighScores(JR.cast(this.f_highScoresHelper))) {
                newState = 0l
            } else {
                let mut highScores: JObject = JR.cast(HighScoresHelperBase.jm_getNextHighScores(JR.cast(this.f_highScoresHelper)))
                if (JR.isSame(highScores, NullHighScoresSingletonFactory.jm_getInstance())) {
                    newState = 0l
                } else {
                    ignore(HighScoresPaintable.jm_setHighScores(JR.cast(jm_getRealHighScoresPaintable(this)), JR.cast(highScores)))
                }
            }
        }
        ignore(jm_setState(this, newState))
        ignore(jm_updateDemoState(this))
}
    
and jm_updateDemoState = (this: DemoCanvas) => {
        ignore({
let jlate: (JObject, JObject, JObject) => JObject = JR.cast(JR.lateBound("PreLogUtil.jm_put"))
JR.cast(jlate(JR.cast(JR.toStringOf(JR.cast(SmallIntegerSingletonFactory.jm_createInstance(JR.cast(SmallIntegerSingletonFactory.jm_getInstance()), this.f_state)))), JR.cast(this), JR.cast(this.f_SET_STATE)))
})
        ignore(StatePaintable.jm_setState(JR.cast(jm_getBasicGameDemoPaintable(this)), this.f_state))
        if ((this.f_state == 0l)) {
            this.f_highScoresPaintable = JR.cast(NullPaintable.jm_getInstance())
            this.f_paintedSpecialAnimationInterface = JR.cast(jm_getSpecialAnimationInterface(this))
            if ((!{
let jlate: (JObject) => JObject = JR.cast(JR.lateBound("DemoGameStartupRunnable.jm_isRunning"))
JR.cast(jlate(JR.cast(this.f_demoGameRunnable)))
} && {
let jlate: (JObject) => JObject = JR.cast(JR.lateBound("AllBinaryGameCanvas.jm_isInitialized"))
JR.cast(jlate(JR.cast(this.f_gameCanvas)))
})) {
                ignore({
let jlate: (JObject) => JObject = JR.cast(JR.lateBound("IndexedAnimation.jm_reset"))
JR.cast(jlate(JR.cast(jm_getSpecialAnimationInterface(this))))
})
            }
        } else if ((this.f_state == 1l)) {
            this.f_paintedSpecialAnimationInterface = JR.cast(SpecialAnimation.jm_getInstance())
        } else if ((this.f_state == 2l)) {
            this.f_highScoresPaintable = JR.cast(jm_getRealHighScoresPaintable(this))
        }
        let mut gameAdState: JObject = JR.cast(GameAdStateFactory.jm_getCurrentInstance(JR.cast(this.f_gameAdStateFactory)))
        ignore({
let jlate: (JObject) => JObject = JR.cast(JR.lateBound("GameAdState.jm_processPageAdState"))
JR.cast(jlate(JR.cast(gameAdState)))
})
}
    
