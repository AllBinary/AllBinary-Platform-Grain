        ignore(GameEventHandlerUtil.jm_removeAllListeners())
        let mut gameCanvasRunnableInterface: GameCanvasRunnableInterface = JR.cast(this.f_allbinaryGameCanvasRunnableInterface)
        if ((!JR.isSame(gameCanvasRunnableInterface, NullGameCanvasRunnable.jstatic_NULL_GAME_CANVAS_RUNNABLE()))) {
