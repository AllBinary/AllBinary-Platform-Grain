and jnew_1 = (maxHealth: Int32) => {
    let this = { jobject: JR.newJObject("Health"), f_health: 0l, f_maxHealth: 0l, f_healthListenerInterface: JR.nullOf(), }
    this.jobject.toStringFunction = () => jm_toString(this)
    
    
    this.f_healthListenerInterface = JR.cast(NullHealthListener.jstatic_NULL_HEALTH_LISTENER())
        ignore(jm_setMaxHealth(this, maxHealth))
        ignore(jm_setHealth(this, maxHealth))
    this
}
    
and jm_heal = (this: Health, ahealth: Int32) => {
        let mut newHealth: Int32 = Int32.(+)(jm_getHealth(this), ahealth)
        if (Int32.(>)(newHealth, jm_getMaxHealth(this))) {
            ignore(jm_setHealth(this, jm_getMaxHealth(this)))
        } else {
            ignore(jm_setHealth(this, newHealth))
        }
}
    
and jm_healMax = (this: Health) => {
        ignore(jm_setHealth(this, jm_getMaxHealth(this)))
}
    
and jm_isDamaged = (this: Health) => {
        if ((jm_getHealth(this) != jm_getMaxHealth(this))) {
            return true
        } else {
            return false
        }
}
    
and jm_damage = (this: Health, ahealth: Int32) => {
        if (Int32.(<)(ahealth, 0l)) {
            let mut stringBuffer: StringMaker = StringMaker.jnew_0()
            ignore(StringMaker.jm_append(JR.cast(stringBuffer), JR.cast("******* Trying to heal when damaging. Damage: ")))
            ignore(StringMaker.jm_appendint(JR.cast(stringBuffer), ahealth))
            ignore(StringMaker.jm_append(JR.cast(stringBuffer), JR.cast(CommonSeps.jm_getInstance().f_SPACE)))
            ignore(StringMaker.jm_append(JR.cast(stringBuffer), JR.cast(jm_toString(this))))
            ignore(ForcedLogUtil.jm_log(JR.cast(StringMaker.jm_toString(JR.cast(stringBuffer))), JR.cast(this)))
            return void
        }
        let mut health: Int32 = Int32.(-)(jm_getHealth(this), ahealth)
        ignore(jm_setHealth(this, health))
    return void
}
    
and jm_isAlive = (this: Health) => {
        if (Int32.(<=)(jm_getHealth(this), 0l)) {
            return false
        } else {
            return true
        }
}
    
and jm_getMaxHealth = (this: Health) => {
        return this.f_maxHealth
}
    
and jm_setMaxHealth = (this: Health, maxHealth: Int32) => {
        this.f_maxHealth = maxHealth
}
    
and jm_setHealth = (this: Health, health: Int32) => {
        if (Int32.(>)(health, jm_getMaxHealth(this))) {
            this.f_health = jm_getMaxHealth(this)
        } else if (Int32.(<)(health, 0l)) {
            this.f_health = 0l
        } else {
            this.f_health = health
        }
        if (!JR.isNull(this.f_healthListenerInterface)) {
            ignore({
let jlate: (JObject) => JObject = JR.cast(JR.lateBound("HealthListenerInterface.jm_onHealthChange"))
JR.cast(jlate(JR.cast(this.f_healthListenerInterface)))
})
        }
}
    
and jm_getHealth = (this: Health) => {
        return this.f_health
}
    
and jm_addListener = (this: Health, healthGraphic: HealthListenerInterface) => {
        this.f_healthListenerInterface = JR.cast(healthGraphic)
}
    
and jm_toString = (this: Health) => {
        let mut stringBuffer: StringMaker = StringMaker.jnew_0()
        ignore(StringMaker.jm_append(JR.cast(stringBuffer), JR.cast(jstatic_HEALTH_LABEL())))
        ignore(StringMaker.jm_appendint(JR.cast(stringBuffer), this.f_health))
        ignore(StringMaker.jm_append(JR.cast(stringBuffer), JR.cast(jstatic_MAX_HEALTH_LABEL())))
        ignore(StringMaker.jm_appendint(JR.cast(stringBuffer), this.f_maxHealth))
        return StringMaker.jm_toString(JR.cast(stringBuffer))
}

