        ignore(StringMaker.jm_append(stringBuffer, "Solution 3: Add the JDBC driver to the WEB-INF/lib directory where you installed this webapp.<br/>"))
        ignore(StringMaker.jm_append(stringBuffer, "2. The JDBC driver you specified does not exit.<br/>"))
        ignore(StringMaker.jm_append(stringBuffer, "Solution: Get a JDBC driver. <br/>"))
        ignore(StringMaker.jm_append(stringBuffer, "3. The JDBC driver you specified is not valid.<br/>"))
