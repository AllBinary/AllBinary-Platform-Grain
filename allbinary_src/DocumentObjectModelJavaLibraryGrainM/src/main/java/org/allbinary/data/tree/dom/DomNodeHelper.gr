                    if (!jfirst) {
                        index = Int32.(+)(index, 1l)
                    }
                    jfirst = false
                    if (!(Int32.(<)(index, NodeList.jm_getLength(nodeList)))) break
                node = NodeList.jm_item(nodeList, index)
                if ((Node.jm_getNodeType(node) == 1l)) {
                    break
                }
                }
            }
        }
        return node
}
    
and jm_getTextNodeValue_1 = (node: Node) => {
        let mut nodeTextNode: Node = JR.cast(Node.jm_getFirstChild(node))
