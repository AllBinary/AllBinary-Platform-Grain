and jm_getFirstChildElement = (parentNode: Node) => {
        let mut node: Node = JR.cast(Node.jm_getFirstChild(parentNode))
        if ((!JR.isNull(node) && (Node.jm_getNodeType(node) != Node.jstatic_ELEMENT_NODE()))) {
            let mut nodeList: NodeList = JR.cast(Node.jm_getChildNodes(parentNode))
