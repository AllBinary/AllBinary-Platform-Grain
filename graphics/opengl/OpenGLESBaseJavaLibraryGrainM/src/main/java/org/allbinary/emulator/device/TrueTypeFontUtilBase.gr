            textureSize = 128l
        } else if (Int32.(<=)(textureSize, 256l)) {
            textureSize = 256l
        } else if (Int32.(<=)(textureSize, 512l)) {
            textureSize = 512l
        } else if (Int32.(<=)(textureSize, 1024l)) {
            textureSize = 1024l
        }
        return textureSize
}
    
and jm_getCellSize = (this: TrueTypeFontUtilBase, cellSize: Int32) => {
    let mut cellSize = cellSize
